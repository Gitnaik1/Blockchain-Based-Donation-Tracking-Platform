{
  "name": "trustdonate-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "compile": "hardhat --config hardhat.config.cjs compile",
    "test:contracts": "hardhat --config hardhat.config.cjs test",
    "test:server": "mocha server/tests/*.test.cjs",
    "test:frontend": "node --test tests/*.test.js",
    "test": "npm run test:contracts && npm run test:server && npm run test:frontend",
    "server": "node server/src/server.cjs",
    "deploy:local": "hardhat --config hardhat.config.cjs run scripts/deploy.cjs",
    "export:artifacts": "node scripts/export-artifacts.cjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "siwe": "^3.0.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "ethers": "^6.17.0",
    "hardhat": "^2.29.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  }
}
