# ==============================================================================
# TrustDonate Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite)
# ------------------------------------------------------------------------------

# Backend API endpoint
VITE_API_BASE_URL=http://localhost:5001/api/v1

# Feature flag: set to 'false' to connect to live backend API instead of local mock adapter
VITE_USE_MOCK_BACKEND=false

# Feature flag: set to 'true' to force simulated chain execution even if MetaMask is connected
VITE_USE_MOCK_CHAIN=false

# Target Chain ID (Polygon Amoy Testnet: 80002)
VITE_TARGET_CHAIN_ID=80002

# Public IPFS Gateway
VITE_IPFS_GATEWAY=https://ipfs.io/ipfs/


# ------------------------------------------------------------------------------
# Backend Server Configuration (Node.js / Express)
# ------------------------------------------------------------------------------

# Server listen port
PORT=5001

# Node runtime environment (development | production | test)
NODE_ENV=development

# Database path (SQLite file)
DATABASE_PATH=data/trustdonate.db

# JWT Secret for session tokens and challenge HMAC signing (Replace in production!)
JWT_SECRET=trustdonate_production_secret_key_change_me_before_deploy

# Application domain and URI for SIWE (EIP-4361) challenge verification
APP_DOMAIN=trustdonate.org
APP_URI=https://trustdonate.org

# Allowed CORS origins (Frontend URL)
CORS_ORIGIN=http://localhost:5173

# Polygon Amoy RPC endpoint for on-chain reconciliation and balance indexing
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology/
